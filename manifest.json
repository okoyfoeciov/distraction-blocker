{
  "manifest_version": 3,
  "name": "Distraction Blocker",
  "short_name": "Distraction Blocker",
  "version": "2.1.0",
  "description": "Block distracting sites on your schedule and remove YouTube's recommendation sidebar. No toggle.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["alarms", "declarativeNetRequest"],
  "host_permissions": [
    "https://substack.com/*",
    "https://*.substack.com/*",
    "http://substack.com/*",
    "http://*.substack.com/*",
    "https://news.ycombinator.com/*",
    "http://news.ycombinator.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "blocklist",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
