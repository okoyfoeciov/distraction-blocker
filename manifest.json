{
  "manifest_version": 3,
  "name": "YouTube Sidebar Blocker",
  "short_name": "YT Sidebar Blocker",
  "version": "1.1.0",
  "description": "Permanently hide YouTube's right-hand sidebar on video pages. No toggle, no distractions.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
